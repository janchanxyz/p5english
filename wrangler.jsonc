{
  "name": "p5english",
  "compatibility_date": "2026-10-28",
  "main": "src/worker.js",
  "ai": {
    "binding": "AI"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "kv_namespaces": [
    {
      "binding": "REPORTS",
      "id": "aae0c546dcfc477192f6ffefd9abef8d"
    }
  ]
}
