{
  "name": "p5english",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "p5english \u2014 Primary 5 English spelling game for Cloudflare Workers",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy",
    "words": "python3 scripts/build_words.py",
    "images": "python3 scripts/enrich_images.py",
    "tts": "python3 scripts/generate_static_tts.py"
  },
  "devDependencies": {
    "vite": "^6.0.0",
    "wrangler": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261104.1": true
  }
}
